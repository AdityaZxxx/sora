// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Better Auth core models (user IDs are referenced by the app tables through
// WalletMembership.userId and Transaction.addedById, migrated from Clerk
// with their original IDs preserved)
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  memberships        WalletMembership[]
  addedTransactions  Transaction[]
  settlementsPaid    Settlement[] @relation("SettlementPayer")
  settlementsReceived Settlement[] @relation("SettlementReceiver")
  createdInviteLinks InviteLink[]
  notifications      Notification[]
  transactionShares  TransactionShare[]
  apiTokens          ApiToken[]
}

model Wallet {
  id        String   @id @default(uuid())
  name      String?
  currency  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Agent access is opt-in per wallet. Off means no token can be created
  // and no existing token works.
  agentAccessEnabled Boolean @default(false)

  memberships  WalletMembership[]
  inviteLinks  InviteLink[]
  transactions Transaction[]
  settlements  Settlement[]
  categories   Category[]
  goals        Goal[]
  budgets      Budget[]
  notifications Notification[]
  monthHistory MonthHistory[]
  yearHistory  YearHistory[]
  apiTokens    ApiToken[]
  recurringItems RecurringItem[]
}

model WalletMembership {
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())
  // Opt-in to the daily email digest of unread wallet notifications.
  emailDigest Boolean   @default(false)
  // One owner per wallet is enforced by a partial unique index in migration
  // 20261125170000_add_wallet_roles, which Prisma schema cannot express.
  role        String    @default("member")

  @@id([walletId, userId])
  @@index([userId])
}

model InviteLink {
  id          String    @id @default(uuid())
  token       String    @unique
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
}

// A personal bearer credential for programmatic access. Only the hash is
// stored, so the plaintext is shown once at creation and never again.
model ApiToken {
  id          String    @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  scope       String    @default("read-only")
  tokenHash   String    @unique
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([walletId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Better Auth rate limiting with storage: "database"
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Category {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now())
  name String
  walletId String
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  icon String
  iconKind String @default("emoji")
  iconColor String?
  type String @default("income")

  @@unique([name, walletId, type])
  @@index([walletId, type])
}

model Transaction {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  amount Decimal
  description String @db.VarChar(200)
  date DateTime
  walletId String
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  addedById String
  addedBy User @relation(fields: [addedById], references: [id], onDelete: Cascade)
  type String @default("income")

  category String
  categoryIcon String
  categoryIconKind String @default("emoji")
  categoryIconColor String?

  // null = added through the UI, "agent" = added through an assistant
  addedVia String?

  // Tags the transaction as a contribution to a goal; contributions are
  // normal transactions, so they still count toward spending stats.
  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  shares TransactionShare[]

  @@index([walletId, date])
  @@index([walletId, type])
  @@index([walletId, goalId])
}

// A settlement records money that moved outside Sora between two members of
// one wallet. It is not a ledger transaction and never enters wallet totals,
// budgets, or history rollups.
model Settlement {
  id         String   @id @default(uuid())
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  payerId    String
  payer      User     @relation("SettlementPayer", fields: [payerId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("SettlementReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  amount     Decimal
  date       DateTime
  note       String?
  addedVia   String?
  createdAt  DateTime @default(now())

  @@index([walletId, date])
}

model TransactionShare {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal

  @@id([transactionId, userId])
}

// A wallet-level definition of a repeating income or expense. It is a
// reminder, never a ledger entry: members record the real transaction from
// the list when it comes due. lastPostedAt is the moment the member last
// confirmed one; an item is due when it has no posting for the occurrence
// on or before today.
model RecurringItem {
  id          String    @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  name        String
  amount      Decimal
  category    String
  categoryIcon String
  categoryIconKind String @default("emoji")
  categoryIconColor String?
  type        String    @default("expense")
  frequency   String
  weekday     Int?
  dayOfMonth  Int?
  startDate   DateTime?
  endDate     DateTime?
  paused      Boolean   @default(false)
  lastPostedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([walletId])
}

model Goal {
  id          String    @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  name        String
  target      Decimal
  deadline    DateTime?
  createdAt   DateTime  @default(now())

  transactions Transaction[]
}

model MonthHistory {
  walletId String
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  day Int
  month Int
  year Int
  income Decimal
  expense Decimal

  @@id([walletId, day, month, year])
}

model YearHistory {
  walletId String
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  month Int
  year Int
  income Decimal
  expense Decimal

  @@id([walletId, month, year])
}

// Monthly spending limit on one category. "soft" warns at 80%/100% via
// notifications; "hard" rejects expense transactions over the limit.
model Budget {
  id          String    @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category    String
  amount      Decimal
  mode        String    @default("soft")
  createdAt   DateTime  @default(now())

  @@unique([walletId, category])
}

// In-app bell entry for one member; userId is the recipient.
model Notification {
  id          String    @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  message     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([walletId, userId, createdAt])
}
